generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  title       String
  description String?
  icon        String @default("coffee-cup.svg")
  status      Status @default(TODO)
  authorId    String
  idTask      Int     @id @default(autoincrement())
  User        User    @relation(fields: [authorId], references: [idUser])
}

model User {
  idUser String @id @default(uuid())
  Task   Task[]
}

enum Status {
  TODO
  WONT_DO
  COMPLETED
}
